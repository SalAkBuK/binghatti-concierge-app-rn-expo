{
  "name": "binghatti-concierge-app-rn-expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start",
    "start-win": "set NODE_OPTIONS=--max-old-space-size=4096 && expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --android",
    "ios": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --ios",
    "web": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:api": "node -e \"require('./lib/services/api/test.ts').default.runAllTests().then(console.log)\"",
    "typecheck": "npx tsc --noEmit",
    "postinstall": "patch-package",
    "deps:fix-expo": "npx expo install --fix",
    "prebuild": "npx expo prebuild",
    "prebuild:clean": "npx expo prebuild --clean",
    "clean:native": "npx rimraf android ios",
    "build:preview": "eas build --platform android --profile preview",
    "build:preview:clean": "eas build --platform android --profile preview --clear-cache",
    "build:production": "eas build --platform android --profile production",
    "build:production:clean": "eas build --platform android --profile production --clear-cache",
    "build:list": "eas build:list",
    "doctor": "npx expo-doctor",
    "build:local": "npx expo prebuild --platform android && cd android && gradlew assembleRelease",
    "build:local:debug": "npx expo prebuild --platform android && cd android && gradlew assembleDebug",
    "install:device": "adb install android/app/build/outputs/apk/release/app-release.apk",
    "install:device:debug": "adb install android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "axios": "^1.12.2",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.7",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "scheduler": "^0.26.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "cross-env": "^10.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-formatter-codeframe": "^7.32.1",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "patch-package": "^8.0.1",
    "react-native-svg-transformer": "^1.5.1",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  }
}
